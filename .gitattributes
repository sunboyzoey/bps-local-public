# Normalize line endings so the repo behaves the same on every platform.
#
# PowerShell scripts must keep CRLF: Windows PowerShell 5.1 mishandles LF-only
# script files in some cases, and users run these directly from Explorer.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Shell scripts must keep LF, or they fail on Linux/macOS with "bad interpreter".
*.sh    text eol=lf

# Everything else: normalise to LF in the repository.
*.go    text eol=lf
*.md    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Binaries
*.exe   binary
*.zip   binary
*.tar.gz binary

# Unified diff context prefixes must preserve upstream whitespace.
patches/*.patch -whitespace
